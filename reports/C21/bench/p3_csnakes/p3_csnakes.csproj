<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <CSnakesVersion Condition="'$(CSnakesVersion)' == ''">2.0.0-beta.350</CSnakesVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CSnakes.Runtime" Version="$(CSnakesVersion)" />
    <AdditionalFiles Include="bench_mod.py" SourceItemType="Python" />
    <Compile Include="../common/Bench.cs" />
    <None Include="bench_mod.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
